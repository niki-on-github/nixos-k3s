{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePaths": [
    ".gitea/workflows/flux-diff.yaml",
    ".gitea/workflows/nix-cache.yaml"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "labels": [
    "renovatebot"
  ],
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "commitMessageSuffix": "",
  "prHourlyLimit": 999,
  "prConcurrentLimit": 999,
  "minimumReleaseAge": "1 day",
  "helm-values": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      "kubernetes/suspended"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      "kubernetes/suspended",
      "**/zfs-localpv/app/helmrelease.yaml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ],
    "ignorePaths": [
      "kubernetes/suspended"
    ]
  },
  "customManagers": [
    {
    "customType": "regex",
    "managerFilePatterns": [
        "//kubernetes/core/storage/zfs-localpv/app/helmrelease\.yaml$/"
      ],
    "matchStrings": [
      "repository: (?<depName>[^\\s]+)\\s+tag: (?<currentValue>[^\\s]+)"
    ],
    "depNameTemplate": "ghcr.io/{{{depName}}}",
    "datasourceTemplate": "docker"
  },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/apps/.+\\.ya?ml$/",
        "/kubernetes/config/.+\\.ya?ml$/",
        "/kubernetes/core/.+\\.ya?ml$/",
        "/kubernetes/flux/.+\\.ya?ml$/",
        "/kubernetes/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker\\n.*: ?(?<depName>.*?)\\n.*: ?(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/apps/.+\\.ya?ml$/",
        "/kubernetes/config/.+\\.ya?ml$/",
        "/kubernetes/core/.+\\.ya?ml$/",
        "/kubernetes/flux/.+\\.ya?ml$/",
        "/kubernetes/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "- (\\w+://)?(raw\\.)?github(usercontent)?\\.com\\/(?<depName>[\\w\\-_]+\\/[\\w\\-_]+)\\/(.+\\/)?(?<currentValue>v?[\\d+\\.]+)\\/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/apps/.+\\.ya?ml$/",
        "/kubernetes/config/.+\\.ya?ml$/",
        "/kubernetes/core/.+\\.ya?ml$/",
        "/kubernetes/flux/.+\\.ya?ml$/",
        "/kubernetes/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n.*: ?(?<currentValue>.*?)\\n"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/apps/.+\\.ya?ml$/",
        "/kubernetes/config/.+\\.ya?ml$/",
        "/kubernetes/core/.+\\.ya?ml$/",
        "/kubernetes/flux/.+\\.ya?ml$/",
        "/kubernetes/templates/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*=?))?( versionTemplate=(?<versionTemplate>.*=?))?\\n.*: ?(\"?(?<currentValue>[^\"\\n]+=?)\"?)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if versionTemplate}}{{{versionTemplate}}}{{else}}{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: repository=(?<registryUrl>.*?)\n *chart: .*/(?<depName>.*?)\n *version: (?<currentValue>.*)\n"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "chart:\\s*oci://(?<packageName>[^\\s]+)\\s*\\n\\s*version:\\s*(?<currentValue>[0-9a-zA-Z._-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
{
      "matchPackageNames": ["anoxape/csi-provisioner"],
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "type/major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "type/minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "labels": [
        "type/patch"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "addLabels": [
        "renovate/helm"
      ],
      "semanticCommitScope": "helm-chart"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "renovate/container"
      ],
      "semanticCommitScope": "docker-image"
    },
    {
      "groupName": "traefik",
      "matchPackageNames": [
        "/traefik/",
        "/traefik-crds/"
      ]
    },
    {
      "groupName": "coredns",
      "matchPackageNames": [
        "/coredns/"
      ]
    },
    {
      "groupName": "cilium",
      "matchPackageNames": [
        "/cilium/"
      ]
    },
    {
      "groupName": "prometheus",
      "matchPackageNames": [
        "/prometheus/",
        "/thanos/",
        "/kube-prometheus-stack/"
      ]
    },
    {
      "groupName": "ollama",
      "matchPackageNames": [
        "/ollama/"
      ]
    },
    {
      "groupName": "flux",
      "matchPackageNames": [
        "/fluxcd/",
        "/flux-operator/",
        "/flux-instance/"
      ]
    },
    {
      "groupName": "immich",
      "matchPackageNames": [
        "/immich-server/",
        "/immich-machine-learning/",
        "/immich/",
        "/immich-app/"
      ]
    },
    {
      "groupName": "auto-merge",
      "matchPackageNames": [
        "/searxng/",
        "/invidious/",
        "/telegraf/",
        "/nginx/",
        "/redis/",
        "/syncify/"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}
